#include <iostream>
using namespace std;
void swap(int &a,int &b){
    int temp;
    temp = a;
    a = b;
    b = temp;
}

void accept(int arr[],int n){
    for(int i =0;i<n;i++){
        cin>>arr[i];
    }
}
void display(int arr[],int n){
    for (int i =0;i<n;i++){
        cout<<arr[i]<<" ";
    }
}
void bubblesort(int arr[],int n){
    for(int i = n-1;i>=1;i--){
        int didswap = 0;
        for(int j=0;j<i;j++){
            if (arr[j]>arr[j+1]){
                swap(arr[j],arr[j+1]);
                didswap = 1;
            }
           
        }
        if(didswap == 0)
        break;
    }
}
int main(){
    cout<<"Enter size of array:";
    int n;
    cin>>n;
    cout<<"accept array:\n";
    int arr[n];
    accept(arr,n);
    cout<<"Displaying array: \n";
    display(arr,n);
    cout<<"\nSorted array: \n";
    bubblesort(arr,n);
    display(arr,n);
}
